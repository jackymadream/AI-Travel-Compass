# Supabase project credentials
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Cloud Vertex AI embeddings (text-embedding-004, native 768-d)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Local only: path to service-account JSON. On Cloud Run, leave unset (uses runtime SA + ADC).
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json
# Optional: Vertex embedding timeout (seconds)
VERTEX_EMBEDDING_TIMEOUT_SEC=30


# Qdrant
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Optional: Google Places API (New) for POI enrichment during ingest
# https://console.cloud.google.com/apis/library/places.googleapis.com
# GOOGLE_PLACES_API_KEY=your-places-api-key

# Optional: force in-memory mock POIs (tests / offline). Default: live Qdrant+Supabase with mock fallback.
# USE_MOCK_POIS=true

# Search rate limit for unauthenticated clients (SlowAPI)
SEARCH_RATE_LIMIT=15/minute

# Optional Gemini model overrides (Vertex AI — no GEMINI_API_KEY required)
# Generative models often need us-central1 even if embeddings use asia-southeast1.
# GEMINI_LOCATION=us-central1
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-flash

# Next.js Supabase Auth (Phase 5.3) — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Redis cache (Phase 4). If unset/unreachable, in-memory fallback is used.
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional Gemini / generative LLM key (future AgentService LLM seam).
# Heuristic itinerary planner works without this.
# GEMINI_API_KEY=your-gemini-api-key

# Comma-separated allowed frontend origins (production UI + local dev).
CORS_ORIGINS=https://travel.jackymadream.com,http://localhost:3000,http://127.0.0.1:3000

# Next.js frontend → FastAPI base URL
# Local:  http://127.0.0.1:8000
# Prod:   https://api.jackymadream.com
NEXT_PUBLIC_API_URL=https://api.jackymadream.com
