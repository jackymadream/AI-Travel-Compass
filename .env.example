# Supabase project credentials
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Cloud Vertex AI embeddings (text-embedding-004, native 768-d)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json
# Optional: Vertex embedding timeout (seconds)
VERTEX_EMBEDDING_TIMEOUT_SEC=30


# Qdrant
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Optional Redis cache (Phase 4). If unset/unreachable, in-memory fallback is used.
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional Gemini / generative LLM key (future AgentService LLM seam).
# Heuristic itinerary planner works without this.
# GEMINI_API_KEY=your-gemini-api-key

# FastAPI CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js frontend → FastAPI base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
